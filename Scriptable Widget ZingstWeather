 // ======================================================
// Zingst Wetter + Wasser (Scriptable stabil)
// ======================================================

const url = "https://www.zingst.de/ostsee-wetter-zingst";

const req = new Request(url);
let html = await req.loadString();

// HTML vereinheitlichen
html = html.replace(/\s+/g, " ");

// ======================================================
// HELPER: Abschnitt extrahieren
// ======================================================

function extractSection(html, startKeywords, endKeywords) {
  let startIndex = -1;

  for (let k of startKeywords) {
    startIndex = html.indexOf(k);
    if (startIndex !== -1) break;
  }

  if (startIndex === -1) return "";

  let endIndex = -1;

  for (let k of endKeywords) {
    endIndex = html.indexOf(k, startIndex);
    if (endIndex !== -1) break;
  }

  if (endIndex === -1) return "";

  return html.substring(startIndex, endIndex);
}

// ======================================================
// WETTER
// ======================================================

let htmlwetter = extractSection(
  html,
  [
    "Aktuelles Wetter im Ostseeheilbad Zingst",
    "Aktuelles Wetter Zingst"
  ],
  [
    "Tagesverlauf",
    "Tagesverlauf – Wetteraussichten"
  ]
);

// ======================================================
// WASSER
// ======================================================

let htmlwasser = extractSection(
  html,
  [
    "Wassertemperaturen an der Küste",
    "Wassertemperaturen an der Ostseeküste"
  ],
  [
    "Unterschied zwischen Wassertemperatur und Badetemperatur"
  ]
);

// ======================================================
// HELPER: Regex Extract
// ======================================================

function matchValue(section, regex) {
  let m = section.match(regex);
  return m ? m[1] : "n/a";
}

// ======================================================
// DATEN EXTRAKTION
// ======================================================

// Temperatur + gefühlte Temperatur (Wetter-Block)
let temp = matchValue(htmlwetter, /Temperatur[^0-9]*(-?\d+)\s?°/i);
let feelsLike = matchValue(htmlwetter, /Gefühlte Temperatur[^0-9]*(-?\d+)\s?°/i);

// Wassertemperatur (Wasser-Block)
let waterTemp = matchValue(htmlwasser, /(\d+)\s?°/i);

// Wellenhöhe (oft im selben oder nahe Bereich)
let waveHeight = "n/a";

let match = html.match(/Wellenhöhe[\s\S]{0,200}?([\d]+[.,]\d+)\s*m/i);

if (match) {
  waveHeight = match[1].replace(".", ",") + " m";
}

function matchTime(html, label) {
  let regex = new RegExp(label + "\\s*:?\\s*(\\d{2}:\\d{2})", "i");
  let m = html.match(regex);
  return m ? m[1] : "n/a";
}

let sunriseTomorrow = matchTime(html, "Sonnenaufgang morgen");
let sunsetTomorrow = matchTime(html, "Sonnenuntergang morgen");

