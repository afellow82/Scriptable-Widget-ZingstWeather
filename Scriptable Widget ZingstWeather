// Debuglevel
let debuglevel = 1;


const url = "https://www.zingst.de/ostsee-wetter-zingst";

const req = new Request(url);
let html = await req.loadString();

html = html.replace(/\s+/g, " ");


let htmlweather = extractSection(
  html,
  [
    "Aktuelles Wetter im Ostseeheilbad Zingst",
    "Aktuelles Wetter Zingst"
  ],
  [
    "Tagesverlauf",
    "Tagesverlauf – Wetteraussichten"
  ]
);

let htmlwater = extractSection(
  html,
  [
    "Wassertemperaturen an der Küste",
    "Wassertemperaturen an der Ostseeküste"
  ],
  [
    "Unterschied zwischen Wassertemperatur und Badetemperatur"
  ]
);


// data extraction
// temperatur, felt air temperatur
let temp = matchValue(htmlweather, /Temperatur[^0-9]*(-?\d+)\s?°/i);
let feelsLike = matchValue(htmlweather, /Gefühlte Temperatur[^0-9]*(-?\d+)\s?°/i);

// water temperatur
let waterTemp = matchValue(htmlwater, /(\d+)\s?°/i);

// wave height
let waveHeight = "n/a";
let match = html.match(/Wellenhöhe[\s\S]{0,200}?([\d]+[.,]\d+)\s*m/i);
if (match) {
  waveHeight = match[1].replace(".", ",") + " m";
}

// wind speed
let windSpeed = matchValue(
  htmlweather,
  /Wind:\s*([\d]+[.,]\d+)\s*km\/h/i
);

// wind direction
let windDirection = "n/a";

let windDirMatch = htmlweather.match(
  /<\/span>\s*([A-Za-zÄÖÜäöüß]+)\s*<\/div>/i
);

if (windDirMatch) {
  windDirection = windDirMatch[1];
}

// time sunrise and sunset
let sunriseTomorrow = matchTime(html, "Sonnenaufgang morgen");
let sunsetTomorrow = matchTime(html, "Sonnenuntergang morgen");


