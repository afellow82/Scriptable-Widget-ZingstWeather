let t3 = widget.addText(`🌊 Wassertemperatur: ${waterTemp}°C`);
t3.font = Font.systemFont(12);

let t4 = widget.addText(`📏 Wellenhöhe: ${waveHeight}`);
t4.font = Font.systemFont(12);

let t5 = widget.addText(`🌅 Sonnenaufgang morgen: ${sunriseTomorrow} Uhr`);
t5.font = Font.systemFont(12);

let t6 = widget.addText(`🌇 Sonnenuntergang morgen: ${sunsetTomorrow} Uhr`);
t6.font = Font.systemFont(12);

widget.addSpacer();

widget.presentMedium();
Script.setWidget(widget);
Script.complete();
