// Version
const version = "0.11";
// 29.05.2026

// ToDo / Bugs / Ideen:
// ChatGPT alles prüfen und verbessern lassen

const startTime = Date.now();

// Debuglevel
let debuglevel = 0;

const url = "https://www.zingst.de/ostsee-wetter-zingst";

// cache html 30 minutes
const cacheMinutes = 30;

const fm = FileManager.local();

const cachePath = fm.joinPath(
  fm.cacheDirectory(),
  "zingst_weather_cache.html"
);

let html;
let cacheAgeMinutes = -1;

// Prüfen ob Cache existiert
if (fm.fileExists(cachePath)) {

  const creationDate = fm.modificationDate(cachePath);
  const now = new Date();

  cacheAgeMinutes =
    (now.getTime() - creationDate.getTime()) / 1000 / 60;

  debugLog(1, `Cache Alter: ${cacheAgeMinutes.toFixed(1)} Minuten`);

  if (cacheAgeMinutes < cacheMinutes) {

    debugLog(1, "Benutze Cache-Datei");

    html = fm.readString(cachePath);

  } else {

    debugLog(1, "Cache zu alt → lade neu");

    const req = new Request(url);
    html = await req.loadString();

    fm.writeString(cachePath, html);

    cacheAgeMinutes = 0;
  }

} else {

  debugLog(1, "Kein Cache vorhanden → lade neu");

  const req = new Request(url);
  html = await req.loadString();

  fm.writeString(cachePath, html);

  cacheAgeMinutes = 0;
}

// harmonise html
html = html.replace(/\s+/g, " ");

// cut html in pieces
let htmlweather = extractSection(
  html,
  [
    "Aktuelles Wetter im Ostseeheilbad Zingst",
    "Aktuelles Wetter Zingst"
  ],
  [
    "Tagesverlauf",
    "Tagesverlauf – Wetteraussichten"
  ]
);

let htmlwater = extractSection(
  html,
  [
    "Wassertemperaturen an der Ostseek&uuml;ste von Dar&szlig;/Zingst",
  ],
  [
    "Unterschied zwischen Wassertemperatur und Badetemperatur"
  ]
);

// extract data
let temp = matchValue(htmlweather, /Temperatur[^0-9]*(-?\d+)\s?°/i);

let feelsLike = matchValue(htmlweather, /Gefühlte Temperatur[^0-9]*(-?\d+)\s?°/i);

let waterTemp = matchValue(
  htmlwater,
  /Wassertemperatur:\s*<[^>]*>\s*(\d+)\s*°/i
);

let waveHeight = "n/a";

let match = html.match(/Wellenhöhe[\s\S]{0,200}?([\d]+[.,]\d+)\s*m/i);

if (match) {
  waveHeight = match[1].replace(".", ",") + " m";
}

let windSpeed = matchValue(
  htmlweather,
  /Wind:\s*([\d]+[.,]\d+)\s*km\/h/i
);

let windDirection = "n/a";

let windDirMatch = htmlweather.match(
  /<\/span>\s*([A-Za-zÄÖÜäöüß]+)\s*<\/div>/i
);

if (windDirMatch) {
  windDirection = windDirMatch[1];
}

let sunsetTomorrow = matchTime(html, "Sonnenuntergang morgen");

// debugging
debugLog(1, "===== HTML weather =====");
debugLog(1, htmlweather);
logDivider(1);

debugLog(1, "===== HTML water =====");
debugLog(1, htmlwater);
logDivider(1);

debugLog(1, "===== PARSED VALUES =====");
debugLog(1, `Temperatur: ${temp}`);
debugLog(1, `Gefühlt: ${feelsLike}`);
debugLog(1, `Wasser: ${waterTemp}`);
debugLog(1, `Wellenhöhe: ${waveHeight}`);
debugLog(1, `Wind: ${windSpeed} km/h`);
debugLog(1, `Windrichtung: ${windDirection}`);

// widget with background
let widget = new ListWidget();

widget.url = url;

// background picture
const imageUrl = "https://www.ostsee-und-wellness.de/ostseeurlaub/fischland-darss-zingst/urlaub-darss-zingst-gross.jpg";

const bgCachePath = fm.joinPath(
  fm.cacheDirectory(),
  "zingst_weather_bg.jpg"
);

let bgImage;

const bgMaxAge = 24 * 60 * 60 * 1000;

if (fm.fileExists(bgCachePath)) {

  const modDate = fm.modificationDate(bgCachePath);

  if ((Date.now() - modDate.getTime()) < bgMaxAge) {

    bgImage = fm.readImage(bgCachePath);

  } else {

    const req = new Request(imageUrl);
    bgImage = await req.loadImage();

    fm.writeImage(bgCachePath, bgImage);
  }

} else {

  const req = new Request(imageUrl);
  bgImage = await req.loadImage();

  fm.writeImage(bgCachePath, bgImage);
}

widget.backgroundImage = bgImage;

const overlay = new LinearGradient();
overlay.locations = [0, 1];
overlay.colors = [
  new Color("#000000", 0.15),
  new Color("#000000", 0.55)
];

widget.backgroundGradient = overlay;

widget.setPadding(12, 12, 12, 12);

// header
let header = widget.addStack();
header.layoutVertically();

// title
let title = header.addText("Wetter und Wasser im Ostseeheilbad Zingst");
title.font = Font.boldSystemFont(14);
title.textColor = Color.white();

// date / time
const now = new Date();

const dateStr = now.toLocaleDateString("de-DE", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric"
});

const timeStr = now.toLocaleTimeString("de-DE", {
  hour: "2-digit",
  minute: "2-digit"
});

let stand = header.addText(
  `Stand: ${dateStr} ${timeStr} Uhr`
);

stand.font = Font.systemFont(10);
stand.textColor = new Color("#FFFFFF", 0.8);

widget.addSpacer(8);

// output data weather
let t1 = widget.addText(
  `🌡️ Temperatur: ${temp}°C (gefühlt: ${feelsLike}°C)`
);
t1.font = Font.systemFont(12);
t1.textColor = Color.white();

widget.addSpacer(5);

let t3 = widget.addText(
  `🌊 Wassertemperatur: ${waterTemp}°C`
);
t3.font = Font.systemFont(12);
t3.textColor = Color.white();

widget.addSpacer(2);

let t4 = widget.addText(
  `📏 Wellenhöhe: ${waveHeight}`
);
t4.font = Font.systemFont(12);
t4.textColor = Color.white();

widget.addSpacer(2);

let tWind = widget.addText(
  `💨 Wind: ${windSpeed} km/h (${windDirection})`
);
tWind.font = Font.systemFont(12);
tWind.textColor = Color.white();

widget.addSpacer(5);

let t6 = widget.addText(
  `🌇 Sonnenuntergang morgen: ${sunsetTomorrow} Uhr`
);
t6.font = Font.systemFont(12);
t6.textColor = Color.white();

widget.addSpacer();

// footer
const endTime = Date.now();

const loadingTime = (
  (endTime - startTime) / 1000
)
.toFixed(1)
.replace('.', ',');

let footerStack = widget.addStack();
footerStack.addSpacer();

let footer = footerStack.addText(
  `[v${version}, ${cacheAgeMinutes.toFixed(0)} min, ${loadingTime} s]`
);

footer.font = Font.systemFont(8);
footer.textColor = new Color("#FFFFFF", 0.7);

// ======================================================
// OUTPUT
// ======================================================

widget.presentMedium();
Script.setWidget(widget);
Script.complete();

// ======================================================
// FUNCTIONS
// ======================================================

function extractSection(html, startKeywords, endKeywords) {

  let startIndex = -1;

  for (let k of startKeywords) {
    startIndex = html.indexOf(k);
    if (startIndex !== -1) break;
  }

  if (startIndex === -1) return "";

  let endIndex = -1;

  for (let k of endKeywords) {
    endIndex = html.indexOf(k, startIndex);
    if (endIndex !== -1) break;
  }

  if (endIndex === -1) return "";

  return html.substring(startIndex, endIndex);
}

function matchTime(html, label) {
  let regex = new RegExp(label + "\\s*:?\\s*(\\d{2}:\\d{2})", "i");
  let m = html.match(regex);
  return m ? m[1] : "n/a";
}

function matchValue(section, regex) {
  let m = section.match(regex);
  return m ? m[1] : "n/a";
}

function logDivider(level) {
  if (debuglevel >= level) console.log("-------------------");
}

function debugLog(level, text) {
  if (debuglevel >= level) console.log(text);
}
