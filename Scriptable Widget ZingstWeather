let feelsLike = matchValue(htmlwetter, /Gefühlte Temperatur[^0-9]*(-?\d+)\s?°/i);

// water temperatur
let waterTemp = matchValue(htmlwasser, /(\d+)\s?°/i);

// wave height
let waveHeight = "n/a";
let match = html.match(/Wellenhöhe[\s\S]{0,200}?([\d]+[.,]\d+)\s*m/i);
if (match) {
  waveHeight = match[1].replace(".", ",") + " m";
}

// time sunrise and sunset
let sunriseTomorrow = matchTime(html, "Sonnenaufgang morgen");
let sunsetTomorrow = matchTime(html, "Sonnenuntergang morgen");


