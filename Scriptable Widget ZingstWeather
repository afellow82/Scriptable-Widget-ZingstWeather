// function extract section from HTML
function extractSection(html, startKeywords, endKeywords) {
  let startIndex = -1;

  for (let k of startKeywords) {
    startIndex = html.indexOf(k);
    if (startIndex !== -1) break;
  }

  if (startIndex === -1) return "";

  let endIndex = -1;

  for (let k of endKeywords) {
    endIndex = html.indexOf(k, startIndex);
    if (endIndex !== -1) break;
  }

  if (endIndex === -1) return "";

  return html.substring(startIndex, endIndex);
}


// function extract time for sunrise and sunset
function matchTime(html, label) {
  let regex = new RegExp(label + "\\s*:?\\s*(\\d{2}:\\d{2})", "i");
  let m = html.match(regex);
  return m ? m[1] : "n/a";
}


// function extract values
function matchValue(section, regex) {
  let m = section.match(regex);
  return m ? m[1] : "n/a";
}


// function debugDivider
function logDivider(level) {
  if (debuglevel >= level) console.log("-------------------");
}


// function debugLog
function debugLog(level, text) {
  if (debuglevel >= level) console.log(text);
}
